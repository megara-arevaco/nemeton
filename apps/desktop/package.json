{
  "name": "@launcher/desktop",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/render-icon.cjs && electron-vite build",
    "dist:win": "node scripts/render-icon.cjs && electron-vite build && electron-builder --publish never --win nsis portable",
    "dist:win:installer": "node scripts/render-icon.cjs && electron-vite build && electron-builder --publish never --win nsis",
    "dist:win:portable": "node scripts/render-icon.cjs && electron-vite build && electron-builder --publish never --win portable",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/render-icon.cjs",
    "dist:linux": "node scripts/render-icon.cjs && electron-vite build && electron-builder --publish never --linux deb AppImage --x64",
    "dist:linux:deb": "node scripts/render-icon.cjs && electron-vite build && electron-builder --publish never --linux deb --x64",
    "dist:linux:appimage": "node scripts/render-icon.cjs && electron-vite build && electron-builder --publish never --linux AppImage --x64"
  },
  "dependencies": {
    "@launcher/core": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.102.8",
    "electron-updater": "^6.8.9",
    "i18next": "^26.4.2",
    "js-yaml": "^5.4.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.16",
    "webtorrent": "^3.0.21",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/webtorrent": "^3.0.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "io.nemeton.desktop",
    "productName": "Nemeton",
    "publish": {
      "provider": "github",
      "owner": "megara-arevaco",
      "repo": "nemeton"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Nemeton-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nemeton",
      "uninstallDisplayName": "Nemeton",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Nemeton-Portable-${version}.${ext}"
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Game",
      "maintainer": "megara-arevaco <megara-arevaco@users.noreply.github.com>",
      "artifactName": "Nemeton-${version}-${arch}.${ext}",
      "executableName": "nemeton",
      "desktop": {
        "entry": {
          "Name": "Nemeton"
        }
      }
    }
  },
  "description": "Nemeton desktop game library",
  "homepage": "https://github.com/megara-arevaco/nemeton"
}
