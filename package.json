{
  "name": "nemeton",
  "private": true,
  "version": "0.1.2",
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "corepack pnpm --filter @launcher/desktop dev",
    "build": "corepack pnpm --filter @launcher/desktop build",
    "dist:win": "corepack pnpm --filter @launcher/desktop dist:win",
    "dist:win:installer": "corepack pnpm --filter @launcher/desktop dist:win:installer",
    "dist:win:portable": "corepack pnpm --filter @launcher/desktop dist:win:portable",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps packages",
    "lint:fix": "eslint apps packages --fix",
    "prepare": "husky",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "prettier": "3.6.2",
    "typescript-eslint": "^8.68.0"
  }
}
