{
  "name": "nemeton",
  "private": true,
  "version": "0.1.3",
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "corepack pnpm --filter @launcher/desktop dev",
    "build": "corepack pnpm --filter @launcher/desktop build",
    "dist:win": "corepack pnpm --filter @launcher/desktop dist:win",
    "dist:win:installer": "corepack pnpm --filter @launcher/desktop dist:win:installer",
    "dist:win:portable": "corepack pnpm --filter @launcher/desktop dist:win:portable",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps packages e2e playwright.config.ts",
    "lint:fix": "eslint apps packages e2e playwright.config.ts --fix",
    "prepare": "husky",
    "typecheck": "corepack pnpm -r typecheck && corepack pnpm --filter @launcher/desktop exec tsc --noEmit -p ../../e2e/tsconfig.json",
    "test": "corepack pnpm test:e2e",
    "benchmark:performance": "corepack pnpm --filter @launcher/core exec tsx ../../scripts/benchmark-performance.mts",
    "test:e2e": "corepack pnpm build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "prettier": "3.6.2",
    "typescript-eslint": "^8.68.0"
  }
}
